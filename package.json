{
  "name": "capybara-go-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "8.9.2"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "chakra-typegen": "chakra typegen ./src/components/theme/index.ts",
    "check": "pnpm format:check && pnpm lint && pnpm contrast:check && pnpm test && pnpm typecheck && pnpm build",
    "contrast:check": "node scripts/check-theme-contrast.mjs",
    "dev": "vite --host 127.0.0.1 --port 8766",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "pnpm chakra-typegen",
    "preview": "vite preview --host 127.0.0.1 --port 8766",
    "typecheck": "tsc -b --pretty false",
    "prepare": "husky",
    "test": "node --test scripts/guide.test.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "luxon": "^3.7.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-icons": "^5.7.0",
    "react-number-format": "^5.4.5",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "packageManager": "pnpm@8.9.2"
}
